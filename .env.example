# Veritabanı
# Lokal geliştirme (varsayılan): SQLite, kurulum gerektirmez
DATABASE_URL="file:./dev.db"
# VPS / production: PostgreSQL'e geçerken sadece bu satırı değiştirin
# DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/puantaj"

# Auth.js
AUTH_SECRET="degistir-bu-anahtari-uretimde-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Dosya depolama
# local  -> diskte /uploads klasörüne yazar
# s3     -> S3-uyumlu obje depolama (VPS asamasinda)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=2048

S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# SMTP (bildirim + sifremi unuttum e-postalari)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Puantaj Sistemi <bildirim@ajansadi.com>"

APP_URL="http://localhost:3000"
